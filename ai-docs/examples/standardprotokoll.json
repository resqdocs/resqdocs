          {"type": "field", "id": "anamnese-freitext", "title": "Aktuelle Anamnese", "multiline": true, "required": true}
        ]
      },
      {
        "type": "container",
        "id": "xabcde",
        "title": "xABCDE",
        "showTitle": true,
        "collapsible": false,
        "blankLineBefore": true,
        "separator": ". ",
        "heading": {"prefix": "# ", "suffix": " ", "fill": "=", "width": 60, "fillMode": "inclusive"},
        "excludable": false,
        "children": [
          {
            "type": "container",
            "id": "xabcde-x",
            "title": "x",
