          {"type": "field", "id": "allergien-sonstige", "title": "Sonstige", "showTitle": true, "heading": {"prefix": "- ", "suffix": ": ", "fill": "", "width": 0, "fillMode": "inclusive"}, "default": "keine", "required": true}
        ]
      },
      {
