{
  "schema": "resqdocs-protocol",
  "version": 1,
  "tree":
  {
    "type": "container",
    "id": "standardprotokoll",
    "title": "Standardprotokoll",
    "collapsible": true,
    "children": [
      {
        "type": "container",
        "id": "alarmierung",
