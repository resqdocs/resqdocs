            "type": "container",
            "id": "xabcde-e",
            "title": "E",
            "showTitle": true,
            "collapsible": true,
            "titleInline": true,
            "heading": {"prefix": "", "suffix": ": ", "fill": "", "width": 0, "fillMode": "inclusive"},
            "children": [
