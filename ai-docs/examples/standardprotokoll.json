              {"type": "field", "id": "xabcde-b-hypoxie", "title": "B - Hypoxiezeichen", "options": ["Keine Hypoxiezeichen.", "Einsatz der Atemhilfsmuskulatur.", "SpO2-Abfall.", "Unruhe/Verwirrtheit."], "allowCustom": true, "inline": true}
            ]
          },
          {
            "type": "container",
            "id": "xabcde-c",
            "title": "C",
