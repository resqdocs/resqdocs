              {"type": "field", "id": "bodycheck-becken", "title": "Becken", "showTitle": true, "heading": {"prefix": "", "suffix": ": ", "fill": "", "width": 0, "fillMode": "inclusive"}, "options": ["stabil", "instabil", "Druckschmerz"], "allowCustom": true, "inline": true},
