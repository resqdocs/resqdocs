              {"type": "field", "id": "xabcde-e-temp", "title": "E - Temperatur", "options": ["Normotemperiert", "subfebril", "Fieber", "hohes Fieber", "Hyperthermie", "hypotherm", "schwere Hypothermie"], "allowCustom": true, "inline": true},
